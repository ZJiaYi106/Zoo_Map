<!-- 地图导航页：海滨国家森林公园手绘导览图 -->
<wxs src="./map-gesture.wxs" module="gesture" />
<view class="map-page">
  <!-- 顶部合并栏：状态提示 + 起终点选择 -->
  <view class="map-header">
    <text class="nav-hint {{isNavigating?'on':''}}">{{navHintShort}}</text>
    <picker mode="selector" range="{{poiNames}}" value="{{startIndex}}" bindchange="onStartChange">
      <view class="picker">起: {{poiNames[startIndex]}}</view>
    </picker>
    <picker mode="selector" range="{{poiNames}}" value="{{endIndex}}" bindchange="onEndChange">
      <view class="picker">终: {{poiNames[endIndex]}}</view>
    </picker>
  </view>

  <!-- 地图视口 -->
  <view class="map-wrap">
    <view
      id="mapViewport"
      class="inner-map"
      style="{{mapViewportStyle}}"
      data-vw="{{mapCam.vw}}"
      data-vh="{{mapCam.vh}}"
      data-ch="{{mapCam.ch}}"
      data-min-scale="{{mapCam.minScale}}"
      data-max-scale="{{mapCam.maxScale}}"
      data-tx="{{mapCam.tx}}"
      data-ty="{{mapCam.ty}}"
      data-scale="{{mapCam.scale}}"
      mapCam="{{mapCam}}"
      change:mapCam="{{gesture.onGestureData}}"
    >
      <view id="mapScene" class="scene" style="{{sceneStyle}}">
        <view
          class="map-gesture-layer"
          catchtouchstart="{{gesture.touchStart}}"
          catchtouchmove="{{gesture.touchMove}}"
          catchtouchend="{{gesture.touchEnd}}"
          catchtouchcancel="{{gesture.touchCancel}}"
        ></view>
        <image class="map-bg" src="{{mapImage}}" mode="scaleToFill" show-menu-by-longpress="{{false}}" />
        <block wx:for="{{roadSegments}}" wx:key="id">
          <view class="road on-route" style="{{item.style}}"></view>
        </block>
        <block wx:for="{{routeDots}}" wx:key="id">
          <view class="route-dot" style="{{item.style}}"></view>
        </block>
        <block wx:for="{{poiList}}" wx:key="id">
          <view
            class="poi {{item.typeClass}} {{item.onRoute?'on-route':''}} {{item.id===startId?'start':''}} {{item.id===endId?'end':''}} {{item.hidden?'is-hidden':''}}"
            style="left:{{item.x}}%;top:{{item.y}}%;"
            data-id="{{item.id}}"
            catchtap="onPoiTap"
          >
            <view class="poi-hit"></view>
            <view class="dot"></view>
            <text class="label" wx:if="{{item.id===startId || item.id===endId || item.onRoute}}">{{item.name}}</text>
          </view>
        </block>
        <view class="user-pos" style="{{userPosStyle}}">
          <view class="user-pos-dot"></view>
          <text class="user-pos-label">我在这里</text>
        </view>
      </view>
      <view class="coord-tip {{showCoord ? 'on' : ''}}">x: {{coordX}} &nbsp; y: {{coordY}}</view>
      <view class="zoom-bar">
        <view class="zoom-btn" catchtap="onZoomOut">−</view>
        <view class="zoom-btn" catchtap="onZoomReset">全</view>
        <view class="zoom-btn" catchtap="onZoomIn">+</view>
      </view>
    </view>
  </view>

  <!-- 图例折叠栏 -->
  <view class="legend-toggle" bindtap="onToggleLegend">
    <text>{{legendOpen ? '收起图例 ▲' : '展开图例 ▼'}}</text>
  </view>
  <view class="legend-box {{legendOpen ? '' : 'collapsed'}}">
    <view class="route-line-legend" wx:if="{{hasRoute}}">
      <view class="route-line-swatch"></view>
      <text class="route-line-legend-text">绿色线为规划路线，白点为路线节点</text>
    </view>
    <view class="legend-row">
      <block wx:for="{{legendItems}}" wx:key="type">
        <view class="legend-item {{activeLegendType===item.type?'on':''}}" data-type="{{item.type}}" bindtap="onLegendTap">
          <view class="legend-dot {{item.cls}}"></view>
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>
    <view class="legend-targets" wx:if="{{legendPoiList.length>0}}">
      <block wx:for="{{legendPoiList}}" wx:key="id">
        <view class="legend-target" data-id="{{item.id}}" bindtap="onLegendPoiTap">{{item.name}}</view>
      </block>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <view class="route-summary" wx:if="{{hasRoute}}">
      <text class="route-summary-path">{{routeText}}</text>
      <text class="route-summary-meta">{{routeMeters}}m · {{routeMinutes}}min</text>
    </view>
    <view class="footer-actions">
      <button class="footer-btn primary" wx:if="{{!isNavigating}}" bindtap="startNavigation">开始导航</button>
      <button class="footer-btn warn" wx:if="{{isNavigating}}" bindtap="stopNavigation">结束导航</button>
      <button class="footer-btn ghost" bindtap="clearRoute">清除路线</button>
      <button class="footer-btn ghost" bindtap="goAiRoute">AI 规划</button>
      <button class="footer-btn ghost" bindtap="goFacility">设施</button>
    </view>
  </view>

  <!-- POI 详情弹窗 -->
  <view class="popup" wx:if="{{showDetail}}">
    <view class="popup-inner">
      <view class="popup-title">{{currentPoi.name}}</view>
      <text class="popup-desc">{{currentPoi.intro}}</text>
      <view class="popup-actions">
        <button class="popup-btn ghost" bindtap="setStartFromCurrent">设为起点</button>
        <button class="popup-btn ghost" bindtap="setEndFromCurrent">设为终点</button>
        <button class="popup-btn" bindtap="startNavigationToCurrent">导航到这里</button>
      </view>
      <button class="popup-close" bindtap="closePopup">关闭</button>
    </view>
  </view>
</view>
