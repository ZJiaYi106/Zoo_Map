.map-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #e8f0e6;
  box-sizing: border-box;
  overflow: hidden;
}

.nav-bar {
  flex-shrink: 0;
  margin: 14rpx 16rpx 0;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  color: #38534a;
  background: #dfeee8;
}

.nav-bar.on {
  color: #fff;
  background: linear-gradient(90deg, #2d6b5a, #3f8a73);
}

.planner {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
}

.picker {
  background: #fff;
  border: 1rpx solid #d7e4df;
  color: #2d6b5a;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 25rpx;
}

.map-wrap {
  position: relative;
  flex: 1;
  min-height: 48vh;
  margin: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inner-map {
  position: relative;
  border-radius: 18rpx;
  overflow: hidden;
  background: #d4e8d0;
  border: 1rpx solid #b8d4b2;
  box-shadow: 0 8rpx 24rpx rgba(45, 90, 60, 0.12);
  touch-action: none;
}

.scene {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transform-origin: 0 0;
  will-change: transform;
}

.map-gesture-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.zoom-bar {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.zoom-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2d6b5a;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #c5dbd2;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.zoom-btn:active {
  background: #e8f2ee;
}

.map-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  display: block;
}

.road {
  position: absolute;
  height: 6rpx;
  transform-origin: 0 50%;
  z-index: 3;
  border-radius: 999rpx;
  opacity: 0.95;
  pointer-events: none;
}

.road.on-route {
  height: 4rpx;
  z-index: 5;
  border-radius: 0;
  border: none;
  background: linear-gradient(90deg, #7ecf9d 0%, #52b878 50%, #7ecf9d 100%);
  box-shadow:
    0 0 3rpx rgba(82, 184, 120, 0.35),
    0 1rpx 2rpx rgba(82, 184, 120, 0.2);
}

.route-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 3rpx rgba(255, 255, 255, 0.7);
  transform: translate(-50%, -50%);
  z-index: 6;
  pointer-events: none;
}

.poi {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 12;
  min-width: 16rpx;
}

.poi-hit {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  transform: translate(-50%, -50%);
  z-index: 0;
}

.poi.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.dot {
  position: relative;
  z-index: 1;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background: #2e7d32;
  margin: 0 auto 2rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.18);
}

.poi.on-route .dot {
  width: 14rpx;
  height: 14rpx;
  border-width: 2rpx;
  box-shadow: 0 0 0 4rpx rgba(82, 184, 120, 0.32);
  z-index: 1;
}

.poi.start .dot {
  width: 14rpx;
  height: 14rpx;
  border-color: #1e7d32;
  background: #1e7d32;
}

.poi.end .dot {
  width: 14rpx;
  height: 14rpx;
  border-color: #e65100;
  background: #e65100;
}

.poi.type-gate .dot { background: #1e88e5; }
.poi.type-service .dot { background: #7b5fb7; }
.poi.type-scenic .dot { background: #2e7d32; }
.poi.type-view .dot { background: #ef6c00; }
.poi.type-toilet .dot { background: #00838f; }
.poi.type-shop .dot { background: #6d4c41; }
.poi.type-rest .dot { background: #546e7a; }

.label {
  font-size: 16rpx;
  color: #2d3b36;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 6rpx;
  padding: 1rpx 6rpx;
  white-space: nowrap;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.25;
  transform: scale(0.92);
  transform-origin: center top;
}

.poi.on-route .label {
  border: 1rpx solid rgba(82, 184, 120, 0.45);
  background: rgba(236, 252, 242, 0.96);
  color: #2d6b4a;
  font-weight: 600;
}

.user-pos {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 12;
}

.user-pos-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1677ff;
  border: 2rpx solid #fff;
  box-shadow: 0 0 0 5rpx rgba(22, 119, 255, 0.2);
  margin: 0 auto 4rpx;
}

.user-pos-label {
  font-size: 16rpx;
  color: #0f4ea8;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(22, 119, 255, 0.35);
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
  white-space: nowrap;
}

.legend-box {
  flex-shrink: 0;
  margin: 8rpx 12rpx 0;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  max-height: 22vh;
  overflow-y: auto;
}

.legend-title {
  font-size: 22rpx;
  color: #60756d;
  margin-bottom: 8rpx;
}

.route-line-legend {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 12rpx;
  padding: 10rpx 12rpx;
  background: linear-gradient(90deg, rgba(82, 184, 120, 0.10), rgba(130, 210, 160, 0.06));
  border-radius: 10rpx;
  border: 1rpx solid rgba(82, 184, 120, 0.3);
}

.route-line-swatch {
  flex-shrink: 0;
  width: 48rpx;
  height: 14rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(90deg, #7ecf9d 0%, #52b878 50%, #7ecf9d 100%);
  box-shadow: 0 2rpx 8rpx rgba(82, 184, 120, 0.35);
}

.route-line-legend-text {
  font-size: 20rpx;
  color: #3d6b4f;
  line-height: 1.4;
  flex: 1;
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 10rpx;
  border: 1rpx solid #d7e4df;
  border-radius: 999rpx;
  background: #f7fbf9;
  font-size: 22rpx;
  color: #415750;
}

.legend-item.on {
  border-color: #2d6b5a;
  background: #e8f2ee;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.type-all { background: #455a64; }
.legend-dot.type-gate { background: #1e88e5; }
.legend-dot.type-service { background: #7b5fb7; }
.legend-dot.type-scenic { background: #2e7d32; }
.legend-dot.type-view { background: #ef6c00; }
.legend-dot.type-toilet { background: #00838f; }
.legend-dot.type-shop { background: #6d4c41; }
.legend-dot.type-rest { background: #546e7a; }

.legend-targets {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.legend-target {
  font-size: 22rpx;
  color: #2d6b5a;
  border: 1rpx solid #cbe0d8;
  border-radius: 10rpx;
  padding: 6rpx 10rpx;
  background: #f6fbf9;
}


.route-box {
  flex-shrink: 0;
  margin: 14rpx 16rpx 0;
  background: #fff;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.route-title {
  font-size: 24rpx;
  color: #2d6b5a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.route-path {
  display: block;
  font-size: 23rpx;
  color: #333;
  line-height: 1.45;
}

.route-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.route-actions {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.route-btn {
  flex: 1 1 46%;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 34rpx;
  border: 1rpx solid #2d6b5a;
  color: #2d6b5a;
  background: #fff;
  font-size: 24rpx;
}

.route-btn.primary {
  color: #fff;
  background: #2d6b5a;
}

.route-btn.warn {
  color: #fff;
  background: #b75e2f;
  border-color: #b75e2f;
}

.route-btn::after {
  border: none;
}

.toolbar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: center;
  padding: 14rpx 12rpx 18rpx;
  gap: 12rpx;
}

.tool-btn {
  flex: 1 1 0;
  font-size: 24rpx;
  padding: 16rpx 8rpx;
  line-height: 1.3;
  background: #fff;
  color: #2d6b5a;
  border: 1rpx solid #2d6b5a;
  border-radius: 12rpx;
}

.tool-btn::after {
  border: none;
}

.tool-btn.primary {
  background: #2d6b5a;
  color: #fff;
}

.tool-btn:active {
  opacity: 0.85;
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.35);
}

.popup-inner {
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 28rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d6b5a;
  margin-bottom: 16rpx;
}

.popup-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  display: block;
  margin-bottom: 18rpx;
}

.popup-actions {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.popup-btn {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  background: #2d6b5a;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.popup-btn.ghost {
  background: #fff;
  color: #2d6b5a;
  border: 1rpx solid #2d6b5a;
}

.popup-btn::after {
  border: none;
}

.popup-close {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #2d6b5a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.popup-close::after {
  border: none;
}
