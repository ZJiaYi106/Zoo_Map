.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 70% 50% at 50% 0%, rgba(200, 148, 62, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 80% 100%, rgba(27, 67, 50, 0.04) 0%, transparent 70%),
    #F6F3ED;
}

.login-spacer {
  flex: 1;
  min-height: 48rpx;
  width: 100%;
}

.icp-footer {
  width: 100%;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  text-align: center;
  box-sizing: border-box;
}

.icp-text {
  font-size: 22rpx;
  color: #A69780;
  line-height: 1.5;
}

/* === Logo 区域 === */
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.logo-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FBF8F4 0%, #F0EBE2 100%);
  box-shadow:
    0 8rpx 32rpx rgba(44, 34, 24, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.logo-ring::after {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(200, 148, 62, 0.2);
  pointer-events: none;
}

.logo-img {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.logo-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1B4332;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #A69780;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

/* === 接口配置卡片 === */
.dev-box {
  width: 88%;
  padding: 28rpx 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  box-shadow:
    0 4rpx 20rpx rgba(44, 34, 24, 0.06),
    0 1rpx 0 rgba(44, 34, 24, 0.04);
}

.dev-title {
  font-size: 24rpx;
  color: #6B5F50;
  margin-bottom: 16rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.dev-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  background: #F8F6F2;
  border-radius: 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #E6DED2;
  color: #2C2218;
}

.dev-input:focus {
  border-color: #C8943E;
  background: #FDFBF7;
}

.dev-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 18rpx;
  gap: 12rpx;
}

.dev-btn {
  flex: 1;
  font-size: 24rpx !important;
  height: 60rpx;
  line-height: 60rpx;
  background: #F8F6F2;
  color: #6B5F50;
  border-radius: 30rpx;
  border: 1rpx solid #E6DED2;
}

.dev-btn::after {
  border: none;
}

.dev-btn.primary {
  background: linear-gradient(135deg, #C8943E 0%, #D4A853 100%) !important;
  color: #fff !important;
  border: none !important;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(200, 148, 62, 0.25);
}

.dev-btn:active {
  opacity: 0.8;
}

.dev-hint {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #A69780;
  line-height: 1.6;
}

/* === 登录按钮 === */
.login-btn {
  margin-top: 16rpx;
  width: 88% !important;
  height: 52px !important;
  line-height: 52px !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 100%) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  box-shadow: 0 8rpx 24rpx rgba(27, 67, 50, 0.25);
}

.login-btn::after {
  border: none;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #A69780;
  letter-spacing: 1rpx;
}
