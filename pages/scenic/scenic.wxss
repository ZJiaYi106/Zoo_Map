.scenic-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(ellipse 50% 30% at 50% 0%, rgba(27, 67, 50, 0.02) 0%, transparent 70%),
    #F6F3ED;
}

/* === 分类标签 === */
.tabs {
  display: flex;
  flex-direction: row;
  padding: 16rpx 20rpx;
  background: transparent;
  gap: 10rpx;
  flex-wrap: wrap;
  flex-shrink: 0;
}

.tab {
  flex: 1;
  min-width: 20%;
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #6B5F50;
  font-weight: 500;
  box-shadow: 0 1rpx 4rpx rgba(44, 34, 24, 0.03);
  border: 1rpx solid #E6DED2;
}

.tab.active {
  background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 100%);
  color: #fff;
  font-weight: 700;
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(27, 67, 50, 0.2);
}

/* === 收藏标题 === */
.fav-bar {
  padding: 24rpx 28rpx 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1B4332;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.fav-bar::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #C8943E 0%, #1B4332 100%);
}

/* === 列表 === */
.list {
  flex: 1;
  height: 0;
  padding: 12rpx 20rpx 20rpx;
  box-sizing: border-box;
}

/* === 景点卡片 === */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow:
    0 6rpx 22rpx rgba(44, 34, 24, 0.06),
    0 1rpx 0 rgba(44, 34, 24, 0.03);
}

.cover {
  width: 100%;
  display: block;
  min-height: 220rpx;
  background: linear-gradient(135deg, #E6F0EB 0%, #DBE8E2 100%);
}

.card-body {
  padding: 22rpx 26rpx 28rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #2C2218;
  letter-spacing: 0.5rpx;
}

.intro {
  font-size: 26rpx;
  color: #6B5F50;
  line-height: 1.6;
}

/* === 操作按钮 === */
.actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 22rpx;
}

.mini {
  border-radius: 28rpx !important;
  padding: 0 28rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  background: #F8F6F2 !important;
  color: #6B5F50 !important;
  border: 1rpx solid #E6DED2 !important;
}

.mini.primary {
  background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 100%) !important;
  color: #fff !important;
  border: none !important;
  box-shadow: 0 4rpx 14rpx rgba(27, 67, 50, 0.2) !important;
}

.mini::after {
  border: none !important;
}

.mini:active {
  opacity: 0.8 !important;
}

/* === 空状态 === */
.empty {
  text-align: center;
  color: #A69780;
  padding: 100rpx 0;
  font-size: 28rpx;
}

/* === AI 讲解弹窗 === */
.explain-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 17, 7, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
}

.explain-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 20rpx 48rpx rgba(28, 17, 7, 0.18);
}

.explain-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  color: #1B4332;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.explain-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #C8943E 0%, #1B4332 100%);
}

.explain-body {
  flex: 1;
  max-height: 50vh;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5C5040;
}

.btn-primary.small {
  width: 100%;
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-weight: 600;
}
