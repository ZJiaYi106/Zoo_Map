.ai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(ellipse 60% 40% at 50% 0%, rgba(27, 67, 50, 0.02) 0%, transparent 70%),
    #F6F3ED;
}

/* === 工具栏 === */
.ai-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 10rpx;
  background: transparent;
  flex-shrink: 0;
}

.ai-toolbar-hint {
  font-size: 22rpx;
  color: #A69780;
  flex: 1;
  margin-right: 16rpx;
}

.clear-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  color: #C7693A;
  border: 1rpx solid #FCE4D6;
  border-radius: 999rpx;
  font-weight: 500;
}

.clear-btn::after {
  border: none;
}

.clear-btn:active {
  background: #FEF5EF;
}

/* === 消息滚动区 === */
.msg-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  max-width: 84%;
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.msg.user {
  margin-left: auto;
  background: linear-gradient(135deg, #1B4332 0%, #2D5A42 100%);
  color: #fff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 14rpx rgba(27, 67, 50, 0.18);
}

.msg.assistant {
  margin-right: auto;
  background: #FFFFFF;
  color: #2C2218;
  border-bottom-left-radius: 6rpx;
  box-shadow:
    0 3rpx 12rpx rgba(44, 34, 24, 0.05),
    0 0 0 1rpx rgba(27, 67, 50, 0.04);
}

.msg-text {
  white-space: pre-wrap;
  word-break: break-all;
}

/* === 快捷按钮 === */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 20rpx 14rpx;
  gap: 10rpx;
}

.quick-btn {
  flex: 1;
  min-width: 30%;
  font-size: 22rpx;
  line-height: 1.45;
  padding: 14rpx 10rpx;
  background: #FFFFFF;
  color: #1B4332;
  border: 1rpx solid #E6DED2;
  border-radius: 14rpx;
  font-weight: 500;
  box-shadow: 0 1rpx 4rpx rgba(44, 34, 24, 0.03);
  transition: all 0.15s ease;
}

.quick-btn::after {
  border: none;
}

.quick-btn:active {
  background: #FDFBF7;
  border-color: #C8943E;
  box-shadow: 0 2rpx 8rpx rgba(200, 148, 62, 0.1);
}

/* === 输入区域 === */
.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0EBE2;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  background: #F8F6F2;
  border-radius: 38rpx;
  margin-right: 14rpx;
  font-size: 28rpx;
  border: 1rpx solid #E6DED2;
  color: #2C2218;
}

.input:focus {
  border-color: #C8943E;
  background: #FDFBF7;
}

.camera-btn {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #C8943E 0%, #E0A84C 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50%;
  padding: 0;
  margin-right: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(200, 148, 62, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.camera-btn::after {
  border: none;
}

.camera-btn:active {
  transform: scale(0.94);
  background: linear-gradient(135deg, #B8853A 0%, #D49A45 100%);
}

.send-btn {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50%;
  padding: 0;
  box-shadow: 0 4rpx 14rpx rgba(27, 67, 50, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}

.send-btn:active {
  transform: scale(0.94);
}

/* === 语音播报按钮 === */
.voice-row {
  padding: 8rpx 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.voice-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #FDFBF7 0%, #FBF7F1 100%);
  color: #1B4332;
  border: 1.5rpx solid #C8943E;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 10rpx rgba(200, 148, 62, 0.08);
}

.voice-btn::after {
  border: none;
}

.voice-btn:active {
  background: #F5EEDF;
}
