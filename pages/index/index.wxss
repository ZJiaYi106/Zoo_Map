.page {
  padding-bottom: 48rpx;
  background:
    radial-gradient(ellipse 60% 40% at 50% 5%, rgba(27, 67, 50, 0.03) 0%, transparent 70%),
    #F6F3ED;
}

/* === Banner === */
.banner {
  width: 100%;
  height: 440rpx;
  position: relative;
  overflow: hidden;
}

.banner-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.banner-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 260rpx;
  background: linear-gradient(
    to top,
    rgba(27, 43, 30, 0.75) 0%,
    rgba(27, 43, 30, 0.35) 45%,
    transparent 100%
  );
  z-index: 1;
}

.banner-pattern {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background:
    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 20rpx,
      rgba(255, 255, 255, 0.03) 20rpx,
      rgba(255, 255, 255, 0.03) 22rpx
    );
  z-index: 1;
  pointer-events: none;
}

.banner-caption {
  position: absolute;
  left: 32rpx;
  bottom: 40rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.banner-title {
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

.banner-sub {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.banner-sub::before {
  content: '';
  width: 32rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

/* Banner fallback */
.banner-fallback {
  width: 100%;
  height: 440rpx;
  background:
    radial-gradient(ellipse 80% 60% at 30% 20%, rgba(200, 148, 62, 0.12) 0%, transparent 60%),
    linear-gradient(160deg, #1B3329 0%, #1B4332 35%, #2D4A3A 65%, #1B3329 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.banner-fallback::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 40rpx,
      rgba(255, 255, 255, 0.015) 40rpx,
      rgba(255, 255, 255, 0.015) 42rpx
    );
  pointer-events: none;
}

.banner-fallback-title {
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.banner-fallback-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

/* === 景区简介卡片 === */
.intro-card {
  margin: -24rpx 28rpx 28rpx;
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow:
    0 8rpx 28rpx rgba(44, 34, 24, 0.08),
    0 1rpx 0 rgba(44, 34, 24, 0.04);
  position: relative;
  z-index: 3;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #1B4332;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.intro-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #C8943E 0%, #1B4332 100%);
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: #5C5040;
}

/* === 天气卡片 === */
.weather-card {
  margin: 0 28rpx 28rpx;
  padding: 24rpx 20rpx 20rpx;
  background: linear-gradient(135deg, #FDFBF7 0%, #FBF7F1 100%);
  border-radius: 20rpx;
  box-shadow:
    0 4rpx 20rpx rgba(44, 34, 24, 0.05),
    0 1rpx 0 rgba(200, 148, 62, 0.12);
  border: 1rpx solid rgba(200, 148, 62, 0.1);
}

.weather-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.weather-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1B4332;
  margin-right: 12rpx;
}

.weather-sub {
  font-size: 22rpx;
  color: #A69780;
}

.weather-scroll {
  width: 100%;
  white-space: nowrap;
}

.weather-hour {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 130rpx;
  padding: 16rpx 0;
  flex-shrink: 0;
  border-radius: 14rpx;
  margin-right: 4rpx;
}

.weather-hour:active {
  background: rgba(200, 148, 62, 0.06);
}

.wh-time {
  font-size: 24rpx;
  color: #6B5F50;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.wh-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.wh-temp {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C2218;
  margin-bottom: 4rpx;
}

.wh-text {
  font-size: 22rpx;
  color: #8B7B65;
  margin-bottom: 2rpx;
}

.wh-pop {
  font-size: 20rpx;
  color: #4C7B9A;
  font-weight: 500;
}

/* === 功能网格 === */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  justify-content: space-between;
}

.grid-item {
  width: 47%;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 0 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 4rpx 18rpx rgba(44, 34, 24, 0.05),
    0 1rpx 0 rgba(44, 34, 24, 0.03);
  position: relative;
  overflow: hidden;
}

.grid-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #C8943E, #D4B866, #C8943E);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.grid-item:active {
  transform: scale(0.97);
}

.grid-item:active::after {
  opacity: 1;
}

.grid-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 18rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.06));
}

.grid-label {
  font-size: 28rpx;
  color: #2C2218;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* === 底部提示 === */
.scan-tip {
  text-align: center;
  color: #A69780;
  font-size: 24rpx;
  margin: 24rpx 48rpx 0;
  line-height: 1.6;
}

/* === 我的按钮 === */
.mine-link {
  margin: 36rpx auto 0;
  width: 80%;
  height: 48px;
  line-height: 48px;
  text-align: center;
  color: #1B4332;
  font-size: 28rpx;
  font-weight: 600;
  border: 1.5rpx solid #C8943E;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FDFBF7 0%, #FBF7F1 100%);
  box-shadow: 0 2rpx 10rpx rgba(200, 148, 62, 0.08);
  letter-spacing: 2rpx;
}

.mine-link:active {
  opacity: 0.8;
  background: #F5EEDF;
}
